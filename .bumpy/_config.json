{
  "$schema": "../node_modules/@varlock/bumpy/config-schema.json",
  "baseBranch": "main",
  "publish": {
    "provenance": true
  },
  "changelog": [
    "github", {
      "internalAuthors": ["theoephraim", "philmillman", "@app/copilot-swe-agent", "claude"]
    }
  ],
  // The native helper packages are versioned independently of varlock and only
  // released when their binaries change (CI fails a PR that changes native sources
  // without a helper bump file; see scripts/native-sources.ts). The three Rust
  // helpers are built from one crate, so they always release together.
  "fixed": [["@varlock/native-helper-linux-*", "@varlock/native-helper-win32-x64"]],
  "packages": {
    // this is the vscode extension
    "env-spec-language": {
      "skipNpmPublish": true,
      "buildCommand": "bun run package",
      "publishCommand": "bun run publish:vsce && bun run publish:ovsx"
    },
    "@varlock/astro-integration": {
      "cascadeFrom": ["@varlock/vite-integration"]
    },
    "@varlock/cloudflare-integration": {
      "cascadeFrom": ["@varlock/vite-integration"]
    },
    "@varlock/nuxt-integration": {
      "cascadeFrom": ["@varlock/vite-integration"]
    },
    "varlock": {
      "cascadeFrom": {
        // varlock pins the helpers as exact-version optionalDependencies, so a
        // helper release must ship a varlock release carrying the new pin
        "@varlock/native-helper-*": {
          "trigger": "patch",
          "bumpAs": "patch"
        },
        "@env-spec/parser": {
          "trigger": "patch",
          "bumpAs": "patch"
        },
        "@varlock/ci-env-info": {
          "trigger": "patch",
          "bumpAs": "patch"
        }
      }
    }
  }
}
