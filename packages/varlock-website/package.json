    "test:ci": "vitest --run"
  },
  "dependencies": {
    "@iconify/vue": "^5.0.0",
    "@astrojs/markdown-remark": "^7.3.1",
    "@astrojs/mdx": "^8.0.1",
    "@astrojs/partytown": "^2.1.7",
    "@astrojs/sitemap": "^3.7.2",
    "@astrojs/starlight": "^0.42.0",
    "@astrojs/vue": "^7.0.2",
    "astro": "^7.3.2",
    "astro-iconify": "^1.2.0",
    "astro-og-canvas": "^0.13.1",
    "astro-robots-txt": "^1.0.0",
    "canvaskit-wasm": "^0.40.0",
    "outdent": "catalog:",
    "remark-custom-header-id": "^1.0.0",
    "satteri": "^0.10.5",
    "starlight-llms-txt": "^0.11.0",
    "vue": "^3.5.22"
  },
  "devDependencies": {
    "@varlock/astro-integration": "workspace:*",
