{
  "name": "@varlock/nuxt-integration",
  "description": "Nuxt module to use varlock for .env file loading - adds validation, type-safety, and extra security features",
  "version": "0.0.1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dmno-dev/varlock.git",
    "directory": "packages/integrations/nuxt"
  },
  "type": "module",
  "main": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    }
  },
  "files": ["dist"],
  "scripts": {
    "dev": "tsdown --watch",
    "build": "tsdown",
    "test": "vitest",
    "test:ci": "vitest --run",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "varlock",
    "nuxt",
    "nuxtjs",
    "nuxt3",
    "nuxt4",
    "nuxt-module",
    "env",
    ".env",
    "environment variables",
    "env vars",
    "config",
    "security",
    "validation",
    "leak protection",
    "varlock-integration"
  ],
  "author": "dmno-dev",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "varlock": "workspace:^",
    "nuxt": ">=3"
  },
  "dependencies": {
    "@nuxt/kit": "^4.0.3"
  },
  "devDependencies": {
    "@nuxt/schema": "^4.0.3",
    "@types/node": "catalog:",
    "@varlock/vite-integration": "workspace:*",
    "nuxt": "^4.0.3",
    "tsdown": "catalog:",
    "varlock": "workspace:^",
    "vitest": "catalog:"
  }
}
