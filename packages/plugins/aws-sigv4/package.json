{
  "name": "@varlock/aws-sigv4-plugin",
  "description": "Varlock plugin adding AWS SigV4 request re-signing to the credential proxy (the agent signs with placeholder credentials; the proxy re-signs with the real keys)",
  "version": "0.1.0",
  "type": "module",
  "homepage": "https://varlock.dev/plugins/aws-sigv4/",
  "bugs": "https://github.com/dmno-dev/varlock/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dmno-dev/varlock.git",
    "directory": "packages/plugins/aws-sigv4"
  },
  "exports": {
    "./plugin": "./dist/plugin.cjs"
  },
  "files": ["dist"],
  "scripts": {
    "dev": "tsdown --watch",
    "build": "tsdown",
    "test": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "varlock",
    "plugin",
    "varlock-plugin",
    "aws",
    "sigv4",
    "signature-v4",
    "credential-proxy",
    "request-signing",
    "env",
    ".env",
    "dotenv",
    "environment variables",
    "env vars",
    "config"
  ],
  "author": "dmno-dev",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "varlock": "workspace:^"
  },
  "devDependencies": {
    "@smithy/protocol-http": "^5.6.0",
    "@smithy/signature-v4": "^5.7.0",
    "@types/node": "catalog:",
    "tsdown": "catalog:",
    "varlock": "workspace:^",
    "vitest": "catalog:"
  }
}
