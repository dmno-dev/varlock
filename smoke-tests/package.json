{
  "name": "varlock-smoke-tests",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Smoke test suite for varlock",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:keychain": "VARLOCK_RUN_KEYCHAIN_SMOKE=1 vitest run tests/keychain-set.test.ts tests/keychain-import.test.ts"
  },
  "devDependencies": {
    "@nubjs/nub": "0.9.3",
    "@types/node": "^22.0.0",
    "typescript": "^5.9.3",
    "varlock": "link:../packages/varlock",
    "vitest": "^4.0.18"
  },
  "pnpm": {
    "overrides": {
      "@next/env": "link:../packages/integrations/nextjs"
    }
  },
  "packageManager": "pnpm@10.30.2"
}
