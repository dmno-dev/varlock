{
  "name": "@varlock/astro-integration",
  "description": "Astro integration to use varlock for .env file loading - adds validation, type-safety, and extra security features",
  "version": "1.4.1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dmno-dev/varlock.git",
    "directory": "packages/integrations/astro"
  },
  "type": "module",
  "main": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    }
  },
  "files": ["dist"],
  "scripts": {
    "dev": "tsdown --watch",
    "build": "tsdown",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "varlock",
    "astro",
    "env",
    ".env",
    "environment variables",
    "env vars",
    "config",
    "security",
    "validation",
    "leak protection",
    "astro-integration",
    "varlock-integration"
  ],
  "author": "dmno-dev",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "varlock": "workspace:^",
    "astro": ">=4",
    "@varlock/cloudflare-integration": "^1.5.1"
  },
  "peerDependenciesMeta": {
    "@varlock/cloudflare-integration": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@varlock/cloudflare-integration": "workspace:*",
    "@varlock/vite-integration": "workspace:*",
    "astro": ">=5.12.8",
    "tsdown": "catalog:",
    "varlock": "workspace:^",
    "vitest": "catalog:"
  }
}
