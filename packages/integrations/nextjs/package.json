{
  "name": "@varlock/nextjs-integration",
  "description": "drop-in replacement for @next/env that uses varlock to load .env files with validation and extra security features",
  "version": "1.2.2",
  "type": "commonjs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dmno-dev/varlock.git",
    "directory": "packages/integrations/nextjs"
  },
  "main": "dist/next-env-compat.cjs",
  "types": "dist/next-env-compat.d.cts",
  "exports": {
    ".": {
      "types": "./dist/next-env-compat.d.cts",
      "require": "./dist/next-env-compat.cjs",
      "default": "./dist/next-env-compat.cjs"
    },
    "./plugin": {
      "types": "./dist/plugin.d.cts",
      "require": "./dist/plugin.cjs",
      "default": "./dist/plugin.cjs"
    },
    "./loader": {
      "types": "./dist/loader.d.cts",
      "require": "./dist/loader.cjs",
      "default": "./dist/loader.cjs"
    },
    "./dynamic-access": {
      "types": "./dist/dynamic-access.d.cts",
      "require": "./dist/dynamic-access.cjs",
      "default": "./dist/dynamic-access.cjs"
    }
  },
  "files": ["dist"],
  "scripts": {
    "dev": "tsdown --watch",
    "build": "rm -rf dist && tsdown",
    "test": "vitest",
    "test:ci": "vitest --run",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "varlock",
    "nextjs",
    "next.js",
    "env",
    ".env",
    "environment variables",
    "env vars",
    "config",
    "security",
    "validation",
    "leak protection",
    "varlock-integration"
  ],
  "author": "dmno-dev",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "varlock": "workspace:^",
    "next": ">=14"
  },
  "devDependencies": {
    "@babel/parser": "^7.29.3",
    "@env-spec/utils": "workspace:^",
    "@types/node": "catalog:",
    "tsdown": "catalog:",
    "varlock": "workspace:^",
    "vitest": "catalog:"
  }
}
