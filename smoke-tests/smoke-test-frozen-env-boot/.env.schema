# @defaultSensitive=false
# @currentEnv=$APP_ENV
# ---

# @type=enum(development,production)
APP_ENV=development

# @sensitive
SECRET_TOKEN=dev-token

# assigned by the platform when each instance starts, with a fallback
# @type=port @required @dynamic=boot
PORT=3000

# per-instance identity, has to be supplied at boot
# @required @dynamic=boot
INSTANCE_ID=

# a boot item may be built from frozen values (never from another boot item)
# @dynamic=boot
LOG_TAG=app-${APP_ENV}
