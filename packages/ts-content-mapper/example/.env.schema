# Example schema for @varlock/ts-content-mapper.
# There is no @generateTsTypes here: the content mapper types `ENV` from this file while tsc runs.
#
# @currentEnv=$APP_ENV
# @defaultRequired=false @defaultSensitive=false
# ---

# Which environment the app runs in
# @type=enum(development, staging, production) @required
APP_ENV=development

# Port the HTTP server listens on
# @type=port @required
PORT=3000

# Base URL of the upstream API
# @type=url @required
API_URL=https://api.example.com

# @type=enum(debug, info, warn, error) @required
LOG_LEVEL=info

# @type=boolean @required
ENABLE_SIGNUPS=false

# Error reporting, only set in deployed environments
# @type=url
SENTRY_DSN=

# Payment provider secret key, never committed
# @sensitive @required @type=string(startsWith=sk_)
# @example=sk_test_123
STRIPE_SECRET_KEY=
