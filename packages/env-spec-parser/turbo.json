{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      // PEGGY_TRACE changes the generated parser, so it has to be part of the hash -
      // otherwise a traced and an untraced build are interchangeable in the cache, and
      // now that src/grammar.js is a restorable output the wrong one can come back
      "env": ["PEGGY_TRACE"],
      // grammar.peggy lives at the package root, so the shared `src/**` input does not
      // cover it - without it here, editing the grammar would not invalidate the cache
      "inputs": [
        "package.json",
        "tsconfig.json",
        "tsconfig.*.json",
        "tsdown.config.ts",
        "peggy.config.cjs",
        "grammar.peggy",
        "src/**"
      ],
      // src/grammar.js is generated by peggy and gitignored. It has to be declared as an
      // output or a cache hit restores dist/ without it, and anything importing the parser
      // from source (tests resolving through the `ts-src` condition) fails to resolve it
      "outputs": ["dist/**", "src/grammar.js"]
    }
  }
}
