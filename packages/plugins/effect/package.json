{
  "name": "@varlock/effect-plugin",
  "version": "0.1.0",
  "description": "Generate Effect Config modules from Varlock schemas",
  "type": "module",
  "homepage": "https://varlock.dev/plugins/effect/",
  "bugs": "https://github.com/dmno-dev/varlock/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dmno-dev/varlock.git",
    "directory": "packages/plugins/effect"
  },
  "exports": {
    "./plugin": "./dist/plugin.cjs"
  },
  "files": ["dist"],
  "scripts": {
    "dev": "tsdown --watch",
    "build": "tsdown",
    "test": "vitest",
    "test:ci": "vitest --run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.effect3.json"
  },
  "keywords": [
    "varlock",
    "plugin",
    "varlock-plugin",
    "effect",
    "effect-ts",
    "codegen",
    "env",
    ".env",
    "dotenv",
    "environment variables",
    "env vars",
    "config"
  ],
  "author": "dmno-dev",
  "contributors": ["dan-myles (https://github.com/dan-myles)"],
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "effect": ">=3.22.1 <4 || >=4.0.0-rc.113 <5",
    "varlock": "workspace:^"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@varlock/tsconfig": "workspace:*",
    "effect": "4.0.0-rc.115",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "varlock": "workspace:*",
    "vitest": "catalog:"
  }
}
