# @defaultRequired=false @defaultSensitive=false
# @currentEnv=$ALCHEMY_ENV
# ---
# what the alchemy integration exposes while varlock resolves
ALCHEMY_STACK=
ALCHEMY_STAGE=
# @type=boolean
ALCHEMY_DEV=
# @type=enum(development, preview, staging, production, test)
ALCHEMY_ENV=if($ALCHEMY_DEV, development, remap($ALCHEMY_STAGE, /^prod$|^production$/, production, /^staging$|^stage$/, staging, "test", test, undefined, development, /.*/, preview))
# @type=enum(development, preview, staging, production, test)
APP_ENV=$ALCHEMY_ENV
# @sensitive
BETTER_AUTH_SECRET=server-secret-value-long
# @type=url
CORS_ORIGIN=http://localhost:4321
# @type=boolean
FEATURE_FLAG=true
SHARED=server-shared
# @tag(deploy) @sensitive
DEPLOY_HOOK_TOKEN=deploy-hook-value-long
STAGE_SEEN=$ALCHEMY_STAGE
DEV_SEEN=$ALCHEMY_DEV
