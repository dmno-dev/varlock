---
/*
Isolated sandbox for the next landing page iteration: the site header and
footer plus the animated dungeon corridor (wizard journey, doors, torches,
elbow into the footer). Content from the index page is being reintroduced
one block at a time; remaining rooms hold placeholders.
Not linked from anywhere and marked noindex.
*/
import { Image } from "astro:assets";
import { Icon } from "astro-iconify";
import Layout from "../layouts/Layout.astro";
import { sidebar } from "../sidebar";
import { LinkButton, Code } from "@astrojs/starlight/components";
import VarlockRetroBanner from "../components/VarlockRetroBanner.astro";
import WorksWithLogoList from "../components/WorksWithLogoList.astro";
import DungeonPath from "../components/DungeonPath.astro";
import DungeonRoom from "../components/DungeonRoom.astro";
import syntaxLogo from "../assets/other-logos/syntax.svg";
import validationImg from "../assets/demo-images/failing-validation.png";
import intellisenseImg from "../assets/demo-images/intellisense.png";
import multiEnvImg from "../assets/demo-images/multi-env.png";
import externalProvidersImg from "../assets/demo-images/external-providers.png";
import redactionImg from "../assets/demo-images/redaction.png";
import leakImg from "../assets/demo-images/leak.png";
---

<Layout
  title="Landing v2 sandbox"
  description="Work-in-progress landing page rework"
  showSearch={false}
  showSidebar={true}
  hideDesktopSidebar={true}
  sidebar={sidebar}
  head={[{ tag: "meta", attrs: { name: "robots", content: "noindex" } }]}
>
  <main>
    <DungeonPath />
    <div class="container">
      <div class="homepage-hero not-content">
        <VarlockRetroBanner />
        <h1>
          <div>
            <span class="sparkle">AI-safe</span> .env files: <br />
            Schemas for agents, secrets for humans
          </div>
        </h1>
        <div class="hero-wizard-anchor" aria-hidden="true"></div>
      </div>
      <Code
        title=".env.schema"
        lang="env-spec"
        code=`
# Declarative schema: AI agents get full context, never secret values
# @sensitive @required @type=string(startsWith=sk-ant-api)
# @docs(https://platform.claude.com/docs/en/api/overview)
ANTHROPIC_API_KEY=

# @type=enum(development, preview, production, test)
APP_ENV=development # set non-sensitive default values directly

# use function calls and plugins to securely fetch data from external sources
XYZ_TOKEN=op("op://api-prod/xyz/auth-token")
    `
      />
      <p class="env-spec-example-note">
        Unlike <i>.env.example</i>, your <i>.env.schema</i> is a single source of
        truth, built for collaboration, that will never be out of sync. Agents can
        read your schema for full context, without ever seeing your secrets. One
        schema drives validation, encryption, agent isolation, and typed code
        across your whole stack.
      </p>
      <Code
        title=".env.local (git-ignored)"
        lang="env-spec"
        code=`
# built-in encryption for local overrides - NOTHING in plaintext
ANTHROPIC_API_KEY=varlock(local:ABC123...)
      `
      />

      <div class="button-container">
        <LinkButton href="getting-started/introduction">Get Started</LinkButton>
        <LinkButton href="reference/cli-commands">Explore the docs</LinkButton>
      </div>

      <div class="badge-row">
        <a
          href="https://osscar.dev/org/dmno-dev"
          target="_blank"
          rel="noopener noreferrer"
        >
          <img
            src="https://osscar.dev/api/badge?slug=dmno-dev&variant=compact"
            alt="Featured on OSSCAR"
          />
        </a>
        <a
          href="https://www.youtube.com/watch?v=M5IkdUunf8g"
          target="_blank"
          rel="noopener noreferrer"
          class="custom-badge syntax-badge"
        >
          <Image src={syntaxLogo} alt="Syntax" height={36} />
          <span class="badge-text">
            <span class="badge-line">Featured in</span>
            <span class="badge-line">Ep 985</span>
          </span>
        </a>
        <a
          href="https://github.blog/open-source/maintainers/securing-the-ai-software-supply-chain-security-results-across-67-open-source-projects/"
          target="_blank"
          rel="noopener noreferrer"
          class="custom-badge github-badge"
        >
          <Icon name="simple-icons:github" width={32} height={32} />
          <span class="badge-text">
            <span class="badge-line">GitHub Secure</span>
            <span class="badge-line badge-line-green">Open Source Fund</span>
          </span>
        </a>
      </div>

      <DungeonRoom accent="cyan" class="v2-room room-schema" lane entry="left">
        <h2 class="room-title">
          <img
            src="https://varlock-pixel-art.dmno.workers.dev/effects/fire.gif"
          />
          Schema &amp; validation
        </h2>
        <p class="room-subtitle">
          Every variable declared, validated, and typed in one
          <code>.env.schema</code> file
        </p>
        <div class="features-grid">
          <div>
            <div>
              <h3>
                <img
                  src="https://varlock-pixel-art.dmno.workers.dev/potions/2.gif"
                />
                Validation
              </h3>
              <p>
                Types and constraints live in decorator comments. Misconfiguration
                fails at load time with clear errors, long before a broken deploy.
              </p>
            </div>
            <Image
              src={validationImg}
              alt="Validation demo"
              class="img-with-border"
            />
          </div>
          <div>
            <div>
              <h3>
                <img
                  src="https://varlock-pixel-art.dmno.workers.dev/potions/4.gif"
                />
                Environments
              </h3>
              <p>
                Combine defaults, environment-specific .env files, local
                git-ignored overrides, and process env vars. Compose values
                together using functions.
              </p>
            </div>
            <Image
              src={multiEnvImg}
              alt="Multi-env demo"
              class="img-with-border"
            />
          </div>
          <div>
            <div>
              <h3>
                <img
                  src="https://varlock-pixel-art.dmno.workers.dev/potions/3.gif"
                />
                Editor tooling
              </h3>
              <p>
                Syntax highlighting, autocomplete, hover docs, and diagnostics
                for your .env files via the VS Code extension.
              </p>
            </div>
            <Image
              src={intellisenseImg}
              alt="IntelliSense demo"
              class="img-with-border"
            />
          </div>
          <div class="text-only-card">
            <div>
              <h3>
                <img
                  src="https://varlock-pixel-art.dmno.workers.dev/potions/6.gif"
                />
                A real language for .env
              </h3>
              <p>
                16+ data types including arrays and records, resolver functions
                like <code>ref()</code>, <code>fallback()</code>,
                <code>exec()</code>, <code>forEnv()</code>, and
                <code>generateOtp()</code> for TOTP codes, <code>@import</code> to
                share schemas across a monorepo, and builtin CI variables detected
                on 20+ platforms.
              </p>
            </div>
          </div>
        </div>
        <p class="room-links">
          <a href="/reference/item-decorators/">Item decorators</a> ·
          <a href="/reference/data-types/">Data types</a> ·
          <a href="/reference/functions/">Functions</a> ·
          <a href="/guides/environments/">Environments</a> ·
          <a href="/guides/monorepos/">Monorepos</a>
        </p>
      </DungeonRoom>
      <DungeonRoom accent="purple" class="v2-room room-vault" lane entry="right">
        <h2 class="room-title">
          <img
            src="https://varlock-pixel-art.dmno.workers.dev/effects/fire.gif"
          />
          Secrets &amp; encryption
        </h2>
        <p class="room-subtitle">
          Nothing in plaintext: encrypt locally, load from any provider, catch
          leaks
        </p>
        <div class="features-grid">
          <div class="text-only-card">
            <div>
              <h3>
                <img
                  src="https://varlock-pixel-art.dmno.workers.dev/potions/7.gif"
                />
                Local encryption
              </h3>
              <p>
                Encrypt local overrides with keys sealed in your OS: macOS
                Keychain and Secure Enclave, Windows TPM with Hello, Linux, and
                WSL. Ship encrypted env blobs to production with
                <code>@encryptInjectedEnv</code>.
              </p>
            </div>
          </div>
          <div>
            <div>
              <h3>
                <img
                  src="https://varlock-pixel-art.dmno.workers.dev/potions/1.gif"
                />
                Secret providers
              </h3>
              <p>
                Load secrets at runtime from 16 provider plugins: 1Password, AWS,
                Azure, GCP, HashiCorp Vault, Doppler, Infisical, Bitwarden, and
                more. Authenticate with OIDC workload identity instead of
                long-lived keys.
              </p>
            </div>
            <Image
              src={externalProvidersImg}
              alt="External providers demo"
              class="img-with-border"
            />
          </div>
          <div>
            <div>
              <h3>
                <img
                  src="https://varlock-pixel-art.dmno.workers.dev/potions/5.gif"
                />
                Leak scanning
              </h3>
              <p>
                Scan your repo for leaked secret values with <code
                  >varlock scan</code
                >, wire it up as a pre-commit hook, and check code env usage
                against your schema with <code>varlock audit</code>.
              </p>
            </div>
            <Image src={leakImg} alt="Leak scan demo" class="img-with-border" />
          </div>
          <div>
            <div>
              <h3>
                <img
                  src="https://varlock-pixel-art.dmno.workers.dev/potions/8.gif"
                />
                Runtime protection
              </h3>
              <p>
                Redact sensitive values from logs and console output. Detect and
                block secrets leaking into outgoing HTTP responses at runtime.
              </p>
            </div>
            <Image
              src={redactionImg}
              alt="Redaction demo"
              class="img-with-border"
            />
          </div>
        </div>
        <p class="room-links">
          <a href="/guides/secrets/">Managing secrets</a> ·
          <a href="/guides/local-encryption/">Local encryption</a> ·
          <a href="/guides/encrypted-deployments/">Encrypted deployments</a> ·
          <a href="/plugins/overview/">Provider plugins</a>
        </p>
      </DungeonRoom>
      <DungeonRoom accent="red" class="v2-room room-agents proxy-feature" lane entry="left">
        <h2 class="room-title">
          <img
            src="https://varlock-pixel-art.dmno.workers.dev/effects/fire.gif"
          />
          Credential broker for AI agents
        </h2>
        <p class="room-subtitle">
          Run coding agents that only ever hold placeholder secrets
        </p>
        <p class="proxy-lead">
          Run coding agents, MCP servers, and any untrusted tool so they only ever see
          <b>placeholder</b> secrets. The real values are injected at the network boundary
          against a cryptographically verified upstream, and scrubbed back out of responses,
          so a prompt-injected or compromised agent has nothing to leak. You run the broker
          yourself, on the same host as the agent, so the real secrets never go to a third party.
        </p>

        <div class="proxy-diagram">
          <svg viewBox="0 0 760 200" width="100%" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Flow diagram: the agent sends a request carrying a placeholder to the local varlock proxy; the proxy injects the real secret toward a verified upstream API, then scrubs the response back to a placeholder before returning it to the agent.">
            <defs>
              <marker id="hp-arrow-accent" markerWidth="8" markerHeight="8" refX="5" refY="3" orient="auto" markerUnits="strokeWidth">
                <path d="M0,0 L6,3 L0,6 z" fill="var(--brand-cyan, #3b82f6)" />
              </marker>
              <marker id="hp-arrow-muted" markerWidth="8" markerHeight="8" refX="5" refY="3" orient="auto" markerUnits="strokeWidth">
                <path d="M0,0 L6,3 L0,6 z" fill="currentColor" />
              </marker>
            </defs>
            <g fill="none" stroke="currentColor">
              <rect x="15" y="50" width="180" height="100" rx="10" stroke-width="1.5" opacity="0.55" />
              <rect x="290" y="50" width="180" height="100" rx="10" stroke="var(--brand-cyan, #3b82f6)" stroke-width="2" />
              <rect x="565" y="50" width="180" height="100" rx="10" stroke-width="1.5" opacity="0.55" />
            </g>
            <g fill="currentColor" text-anchor="middle">
              <text x="105" y="90" font-size="15" font-weight="600">Agent</text>
              <text x="105" y="110" font-size="11" opacity="0.7">untrusted child</text>
              <text x="105" y="126" font-size="11" opacity="0.7">holds placeholders</text>
              <text x="380" y="88" font-size="15" font-weight="600">varlock proxy</text>
              <text x="380" y="108" font-size="11" opacity="0.7">local, in memory</text>
              <text x="380" y="124" font-size="11" opacity="0.7">swap / verify TLS / scrub</text>
              <text x="655" y="90" font-size="15" font-weight="600">Upstream API</text>
              <text x="655" y="110" font-size="11" opacity="0.7">verified TLS host</text>
            </g>
            <g stroke="var(--brand-cyan, #3b82f6)" stroke-width="1.5" fill="none">
              <line x1="197" y1="85" x2="286" y2="85" marker-end="url(#hp-arrow-accent)" />
              <line x1="472" y1="85" x2="561" y2="85" marker-end="url(#hp-arrow-accent)" />
            </g>
            <g stroke="currentColor" stroke-width="1.5" fill="none" opacity="0.5">
              <line x1="286" y1="118" x2="197" y2="118" marker-end="url(#hp-arrow-muted)" />
              <line x1="561" y1="118" x2="472" y2="118" marker-end="url(#hp-arrow-muted)" />
            </g>
            <g text-anchor="middle" fill="currentColor" font-size="10.5">
              <text x="241" y="79">placeholder</text>
              <text x="516" y="79" font-weight="600">real secret</text>
              <text x="241" y="134" opacity="0.7">scrubbed</text>
              <text x="516" y="134" opacity="0.7">response</text>
            </g>
          </svg>
        </div>

        <div class="proxy-grid">
          <div class="proxy-code">
            <Code
              title=".env.schema"
              lang="env-spec"
              code=`
# @sensitive @proxy(domain="api.stripe.com")
STRIPE_SECRET_KEY=yourPreferredPlugin()
      `
            />
            <Code lang="bash" code={`varlock proxy run -- claude`} />
          </div>
          <ul class="proxy-points">
            <li>
              <b>Placeholder isolation:</b> the agent never holds a real secret, even if
              it re-runs <code>varlock load</code> or reads its own environment.
            </li>
            <li>
              <b>Verified-identity injection:</b> secrets are sent only to upstreams whose
              TLS identity checks out against public CAs, never over cleartext.
            </li>
            <li>
              <b>Scrub and audit:</b> real values are scrubbed back out of responses, and
              every request is logged with no secret values.
            </li>
          </ul>
        </div>

        <ul class="proxy-points warding-extras">
          <li>
            <b>Sandbox the agent too:</b> <code>varlock proxy run --sandbox</code> jails
            the agent with macOS seatbelt or Docker/Podman, with recipes for E2B,
            Fly.io, Docker Sandboxes, and more.
          </li>
          <li>
            <b>Remote brokers:</b> expose the proxy to cloud sandboxes over an
            encrypted tunnel with per-session tokens.
          </li>
          <li>
            <b>Built for agents:</b> <code>varlock init --agent</code> and
            <code>load --agent</code> modes, a bundled agent skill, a hosted docs
            MCP server, and setup guides for Claude Code, Codex, Aider, Goose, and
            more.
          </li>
        </ul>

        <div class="button-container">
          <LinkButton href="guides/proxy/">Credential proxy guide</LinkButton>
          <LinkButton href="sandboxes/overview/">Sandbox recipes</LinkButton>
        </div>
      </DungeonRoom>

      <DungeonRoom accent="green" class="v2-room room-forge" lane entry="right">
        <h2 class="room-title">
          <img
            src="https://varlock-pixel-art.dmno.workers.dev/effects/fire.gif"
          />
          Codegen &amp; integrations
        </h2>
        <p class="room-subtitle">
          Typed env access and drop-in integrations for every stack
        </p>
        <div class="features-grid">
          <div>
            <div>
              <h3>
                <img
                  src="https://varlock-pixel-art.dmno.workers.dev/potions/7.gif"
                />
                Code generation
              </h3>
              <p>
                Generate typed env modules from the schema for TypeScript,
                Python, Rust, Go, PHP, Java, and C#. Each one ships a loader and
                a list of sensitive keys.
              </p>
            </div>
            <Code
              title=".env.schema"
              lang="env-spec"
              code=`
# @generateTsTypes(path=./env.d.ts)
# @generatePythonEnv(path=./env_types.py)
      `
            />
          </div>
          <div>
            <div>
              <h3>
                <img
                  src="https://varlock-pixel-art.dmno.workers.dev/potions/6.gif"
                />
                Run anywhere
              </h3>
              <p>
                <code>varlock run</code> injects resolved, validated env vars into
                any process, in any language. <code>varlock flatten</code> collapses
                your <code>@import</code> graph into a self-contained directory for
                Docker deploys.
              </p>
            </div>
            <Code lang="bash" code={`varlock run -- python my_script.py`} />
          </div>
        </div>
        <p class="works-with-note">
          Framework packages for Next.js, Vite, Astro, Expo, and Cloudflare, a
          GitHub Action, and recipes for Docker, direnv, mise, and more:
        </p>
        <WorksWithLogoList />
        <p class="room-links">
          <a href="/guides/code-generation/">Code generation</a> ·
          <a href="/integrations/overview/">Integrations</a> ·
          <a href="/integrations/github-action/">GitHub Action</a>
        </p>
      </DungeonRoom>

      <DungeonRoom accent="orange" class="v2-room room-quest" lane entry="left">
        <h2 class="room-title">
          <img
            src="https://varlock-pixel-art.dmno.workers.dev/effects/fire.gif"
          />
          Get started
        </h2>
        <p class="room-subtitle">
          Install in one command; migrating from dotenv is a one-line swap
        </p>
        <Code
          lang="bash"
          code=`
# Install as a dependency in a js project
npx varlock init

# OR install as standalone binary via homebrew
brew install dmno-dev/tap/varlock
# OR via cURL
curl -sSfL https://varlock.dev/install.sh | sh -s
    `
        />

        <h3 class="quest-subhead">Drop-in replacement for dotenv</h3>
        <Code
          title="my-app.ts"
          lang="diff"
          meta="lang='ts'"
          code={`
- import 'dotenv/config';
+ import 'varlock/auto-load';

// *optional* type-safe env access
+ import { ENV } from 'varlock/env';
- const client = new AbcApi(process.env.ABC_API_KEY);
+ const client = new AbcApi(ENV.ABC_API_KEY);
`}
        />
        <p class="env-spec-example-note">
          <b>varlock</b> can be used as a direct replacement for <code
            >dotenv</code
          > in most projects. Just swap your import and get validation, security, and
          more. No other code changes required!
        </p>

        <div class="button-container">
          <LinkButton href="getting-started/introduction">Get Started</LinkButton>
          <LinkButton href="guides/migrate-from-dotenv/"
            >Migrate from dotenv</LinkButton
          >
        </div>
      </DungeonRoom>
    </div>
  </main>
</Layout>

<style is:global>
  main {
    position: relative;
    overflow-x: clip; /* the warlock's walk line can poke past narrow viewports */
  }

  .container {
    max-width: 1000px;
    margin: 0 auto;
    padding: 1rem 1rem;
  }
  /* leave a gutter for the warlock's walk lines on small screens; the
     dungeon rooms bleed slightly into it so their content stays roomy */
  @media screen and (max-width: 700px) {
    .container {
      padding: 1rem 32px;
    }
    .v2-room {
      margin-left: -8px;
      margin-right: -8px;
    }
  }

  /* trim the dead space between the last room and the footer area */
  .room-quest {
    margin-bottom: 2.5rem;
  }
  footer {
    margin-top: 0.5rem !important;
  }
  .footer-connect {
    margin-top: 0.75rem !important;
  }

  /* hero block (ported from the index page) */
  .homepage-hero {
    text-align: center;
    margin-bottom: 1rem;
    h1 {
      margin: 0.5em 0;
      display: flex;
      gap: 0em;
      justify-content: center;
      align-items: flex-start;
      font-size: 32px;
      text-wrap: balance;

      @media screen and (max-width: 700px) {
        font-size: 24px;
        gap: 0em;
        flex-direction: column;
        align-items: center;
      }

    }
  }

  /* where the warlock stands before the journey starts (the path-driven
     sprite renders on top of this spot, at double size while in the hero;
     keep these dimensions in sync with the --ws sizes in DungeonPath) */
  .hero-wizard-anchor {
    width: 128px;
    height: 128px;
    margin: 0.5rem auto 0;
  }
  @media screen and (max-width: 700px) {
    .hero-wizard-anchor {
      width: 64px;
      height: 64px;
    }
  }

  .sparkle {
    --sparkle-color: var(--brand-cyan);
    animation: sparkle-pulse 4s ease-in-out infinite;
  }
  :root[data-theme='light'] .sparkle {
    --sparkle-color: var(--brand-purple);
  }
  @keyframes sparkle-pulse {
    0% {
      text-shadow: 0 0 0px var(--sparkle-color);
    }
    50% {
      text-shadow:
        0 0 3px var(--color-text-full-shade-invert),
        0 0 15px var(--sparkle-color);
    }
    100% {
      text-shadow: 0 0 0px var(--sparkle-color);
    }
  }

  .env-spec-example-note {
    padding: 0.5em 1em;
    text-align: center;
    font-weight: bold;
  }

  .button-container {
    display: flex;
    justify-content: center;
    gap: 1rem;
    margin-top: 1.5rem;
    a {
      display: block;
      text-align: center;
      /* Starlight's content flow styles add sibling margins on top of the
         flex gap; spacing comes from the gap alone */
      margin: 0;
    }
  }
  .button-container > .sl-link-button {
    min-width: 25%;
    border: 2px solid transparent;
  }
  .button-container > .sl-link-button:hover {
    background-color: var(--sl-color-black);
    color: var(--sl-color-text-accent);
    border: 2px solid var(--sl-color-text-accent);
    animation: pixelate 1.25s infinite;
  }
  .button-container > .sl-link-button::after {
    content: ' →';
    margin-left: 0.25rem;
    white-space: nowrap;
  }
  /* stacked full-width buttons on small screens so labels stay on one line */
  @media screen and (max-width: 700px) {
    .button-container {
      flex-direction: column;
      align-items: center;
    }
    .button-container > .sl-link-button {
      width: 100%;
      max-width: 320px;
    }
  }
  @keyframes pixelate {
    0% {
      border-style: solid;
    }
    25% {
      border-style: dotted;
    }
    50% {
      border-style: dashed;
    }
    75% {
      border-style: dotted;
    }
    100% {
      border-style: solid;
    }
  }

  /* dungeon room content blocks (ported from the index page) */
  .room-title {
    margin-top: 0.5rem;
    border: none !important;
    gap: 0.3em !important;
  }
  .room-subtitle {
    font-weight: bold;
    opacity: 0.85;
    margin-top: 0.25rem;
  }
  .room-links {
    text-align: center;
    margin-top: 2rem;
    font-size: var(--sl-text-sm);
  }

  .features-grid {
    > div {
      margin-top: 2.5rem;
      display: grid;
      grid-template-columns: 3fr 5fr;
      gap: 1rem;
      align-items: center;
      @media screen and (max-width: 700px) {
