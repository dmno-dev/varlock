# Context the alchemy integration exposes while varlock resolves a schema. Copy these items into
# your .env.schema (or, once package imports land, `@import(npm:@varlock/alchemy-integration/.env.schema)`).
# @defaultRequired=false @defaultSensitive=false
# ---

# Stack name from Alchemy.Stack(...)
ALCHEMY_STACK=
# Deploy stage: `dev_<user>` by default, `pr-42`, `production`, ...
ALCHEMY_STAGE=
# true under `alchemy dev` (local emulation)
# @type=boolean
ALCHEMY_DEV=
# Environment name derived from the run, for `@currentEnv=$ALCHEMY_ENV`. Redefine it in your own
# schema to change the mapping.
# @type=enum(development, preview, staging, production, test)
ALCHEMY_ENV=if($ALCHEMY_DEV, development, remap($ALCHEMY_STAGE, regex("^(prod|production)$"), production, regex("^(staging|stage)$"), staging, "test", test, undefined, development, regex(".*"), preview))
