{
  "name": "@env-spec/utils",
  "private": true,
  "version": "0.0.0",
  "description": "internal utils shared by env-spec and varlock",
  "files": [
    "src",
    "dist"
  ],
  "type": "module",
  "exports": {
    "./*": {
      "ts-src": "./src/*.ts",
      "types": "./dist/*.d.ts",
      "default": "./src/*.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "test": "vitest",
    "test:ci": "vitest --run",
    "typecheck": "tsc --noEmit"
  },
  "author": "dmno-dev",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "catalog:",
    "acorn": "^8.15.0",
    "vitest": "catalog:"
  },
  "dependencies": {
    "@sindresorhus/is": "catalog:",
    "ast-matcher": "^1.2.0",
    "magic-string": "^0.30.17"
  }
}
