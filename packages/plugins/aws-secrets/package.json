{
  "name": "@varlock/aws-secrets-plugin",
  "description": "Varlock plugin to load secrets from AWS (supports both Secrets Manager and Systems Manager Parameter Store)",
  "version": "1.2.3",
  "type": "module",
  "homepage": "https://varlock.dev/plugins/aws-secrets/",
  "bugs": "https://github.com/dmno-dev/varlock/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dmno-dev/varlock.git",
    "directory": "packages/plugins/aws-secrets"
  },
  "exports": {
    "./plugin": "./dist/plugin.cjs"
  },
  "files": ["dist"],
  "scripts": {
    "dev": "tsdown --watch",
    "build": "tsdown",
    "test": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "varlock",
    "plugin",
    "varlock-plugin",
    "aws",
    "secrets-manager",
    "parameter-store",
    "ssm",
    "env",
    ".env",
    "dotenv",
    "environment variables",
    "env vars",
    "config"
  ],
  "author": "dmno-dev",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "varlock": "workspace:^"
  },
  "devDependencies": {
    "@aws-sdk/client-secrets-manager": "^3.700.0",
    "@aws-sdk/client-ssm": "^3.700.0",
    "@aws-sdk/client-sts": "^3.700.0",
    "@aws-sdk/credential-providers": "^3.700.0",
    "@env-spec/utils": "workspace:^",
    "@types/node": "catalog:",
    "tsdown": "catalog:",
    "varlock": "workspace:^",
    "vitest": "catalog:"
  }
}
