# @defaultSensitive=false
# @currentEnv=$APP_ENV
# ---

# @type=enum(development,production)
APP_ENV=development

# @sensitive
SECRET_TOKEN=dev-token

# assigned by the platform when each instance starts, so it cannot be pinned
# @type=port @required @dynamic=boot
PORT=

# per-instance identity, may be absent
# @optional @dynamic=boot
INSTANCE_ID=

# built from a boot value, so it has to be boot too
# @dynamic=boot
PUBLIC_URL=http://localhost:${PORT}
